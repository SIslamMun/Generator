finetuned_unsloth/logs/
finetuner/logs/

# Per-model dedicated venvs (built by each model's install.sh)
finetuned_unsloth/models/*/.venv-*/
# Shared bake-off venv (built by finetuned_unsloth/install_bakeoff.sbatch)
finetuned_unsloth/.venv-bakeoff/

# Reference notebooks clone (a fetch of github.com/unslothai/notebooks; large)
finetuned_unsloth/reference/notebooks/
finetuned_unsloth/reference/*.out
finetuned_unsloth/reference/*.err
finetuned_unsloth/reference/gemma_4_lora/
finetuned_unsloth/reference/outputs/

# Per-model prepared data + trained artifacts (regeneratable)
finetuned_unsloth/models/*/data/
finetuned_unsloth/models/*/artifacts/
# Archived training runs (r8_3ep, r32_3ep, etc.) — large model weights
finetuned_unsloth/models/*/artifacts_*/
finetuned_unsloth/models/*/unsloth_compiled_cache/

# Misc archives (large SLURM stdout history, kept locally only)
misc/finetuned_unsloth_archive/logs/

# Legacy Jarvis-era data + caches (kept under finetuned_unsloth/legacy/ for reference)
finetuned_unsloth/legacy/data/v7_10k_clean/
finetuned_unsloth/legacy/data/v7_delta/
finetuned_unsloth/legacy/data/v7_merged/
outputs/

# Universal training-pipeline runtime — code is committed, run outputs are not
runs/
lancedb_smoke/
lancedb*/
unsloth_compiled_cache/
jarvis_config/

# Generated tool-use corpora (large, kept locally / on scratch)
misc/jarvis/v7_*/

# Google Cloud SDK (not part of project)
google/

# System files
.DS_Store
Thumbs.db

# Node tooling (not a project dep; produced by incidental local tools)
node_modules/
